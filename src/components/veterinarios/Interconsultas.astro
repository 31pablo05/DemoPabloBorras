---
// Interconsultas.astro — Servicio de interconsultas clínicas profesional
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const beneficios = [
  'Respuesta de un especialista con más de 15 años de experiencia clínica.',
  'Análisis detallado del caso: historial, síntomas, diagnósticos diferenciales.',
  'Protocolo de diagnóstico y manejo terapéutico sugerido.',
  'Seguimiento por email hasta la resolución del caso.',
  'Discusión de casos complejos con enfoque evidence-based.',
];

const casosAplica = [
  'Enfermedades vectoriales (Ehrlichia, Babesia, Anaplasma, Dirofilaria, Leishmania)',
  'Infectología canina: moquillo, leptospirosis, parvovirus',
  'Infectología felina: panleucopenia, calicivirus, herpesvirus, VIF/VLFe',
  'Zoonosis: brucelosis canina, tuberculosis bovina en gatos, Strongyloides',
  'Parasitología con diagnóstico molecular',
  'Toxoplasmosis y otras infecciones por protozoos',
  'Diagnóstico diferencial en síndromes febriles o infecciosos complejos',
  'Casos sin diagnóstico con sospecha de causa infecciosa o parasitaria',
];
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Título de sección -->
    <div class="text-center mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
        Servicio para profesionales veterinarios
      </p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
        ¿Cómo funciona el servicio?
      </h2>
      <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
    </div>

    <!-- Descripción del servicio mejorada -->
    <div class="max-w-3xl mx-auto mb-16">
      <div class="bg-gradient-to-br from-blue-50 to-purple-50 p-8 md:p-10 rounded-2xl" style="border-left: 4px solid #1880c9; box-shadow: 0 4px 20px rgba(24,128,201,0.1);">
        <p class="text-base md:text-lg leading-relaxed" style="color: var(--color-text);">
          El servicio de interconsulta está diseñado para veterinarios que enfrentan casos clínicos desafiantes y necesitan una <strong>segunda opinión especializada</strong>. Pablo Borrás analiza el caso, el historial clínico del paciente y propone un enfoque diagnóstico y terapéutico detallado basado en evidencia científica actualizada.
        </p>
      </div>
    </div>

    <!-- Aviso legal mejorado -->
    <div class="max-w-4xl mx-auto mb-16">
      <div
        class="flex gap-5 p-6 md:p-7 rounded-xl relative overflow-hidden"
        style="background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%); border-left: 4px solid #D97706; box-shadow: 0 4px 16px rgba(217,119,6,0.15);"
        role="alert"
      >
        <div class="absolute top-0 right-0 w-32 h-32 opacity-5" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" style="color: #D97706;">
            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
          </svg>
        </div>
        <span class="text-3xl shrink-0" aria-hidden="true">⚠️</span>
        <div class="relative z-10">
          <p class="font-bold text-base mb-2" style="color: #92400E;">Aviso importante para profesionales</p>
          <p class="text-sm leading-relaxed" style="color: #78350F;">
            La interconsulta profesional <strong>no reemplaza al veterinario tratante</strong> del paciente. Es un complemento de apoyo clínico exclusivo para médicos veterinarios. El diagnóstico y tratamiento definitivo corresponde únicamente al profesional a cargo del caso.
          </p>
        </div>
      </div>
    </div>

    <!-- Grid mejorado: Beneficios + Casos aplicables -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 mb-16">

      <!-- Beneficios con estilo celeste -->
      <div
        class="bg-white p-8 md:p-10 rounded-2xl relative overflow-hidden"
        style="box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;"
      >
        <!-- Gradiente de fondo -->
        <div
          style="
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%);
            pointer-events: none;
          "
          aria-hidden="true"
        ></div>
        
        <div style="position: relative; z-index: 1;">
          <!-- Ícono decorativo -->
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-6" style="background: rgba(24,128,201,0.12); border: 2px solid rgba(24,128,201,0.2);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>

          <h3
            class="text-2xl font-bold mb-6"
            style="font-family: var(--font-display); color: var(--color-text);"
          >
            ¿Qué incluye la interconsulta?
          </h3>
          <ul class="space-y-4">
            {beneficios.map(b => (
              <li class="flex items-start gap-3 text-sm md:text-base" style="color: var(--color-text-muted);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="leading-relaxed">{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Casos aplicables con estilo violeta -->
      <div
        class="bg-white p-8 md:p-10 rounded-2xl relative overflow-hidden"
        style="box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-top: 4px solid #4a3d9e;"
      >
        <!-- Gradiente de fondo -->
        <div
          style="
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(74,61,158,0.05) 0%, transparent 100%);
            pointer-events: none;
          "
          aria-hidden="true"
        ></div>
        
        <div style="position: relative; z-index: 1;">
          <!-- Ícono decorativo -->
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-6" style="background: rgba(74,61,158,0.12); border: 2px solid rgba(74,61,158,0.2);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4a3d9e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>

          <h3
            class="text-2xl font-bold mb-6"
            style="font-family: var(--font-display); color: var(--color-text);"
          >
            Especialidades consultadas
          </h3>
          <div class="flex flex-wrap gap-2.5">
            {casosAplica.map(caso => (
              <span
                class="text-xs font-semibold px-3.5 py-2 rounded-lg transition-all hover:scale-105"
                style="background: linear-gradient(135deg, rgba(74,61,158,0.1) 0%, rgba(74,61,158,0.15) 100%); color: #4a3d9e; border: 1.5px solid rgba(74,61,158,0.25);"
              >
                {caso}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- CTA mejorado -->
    <div class="text-center">
      <div class="inline-block">
        <a
          href="/contacto?tab=interconsultas"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
          style="
            background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(24,128,201,0.3);
          "
          onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 32px rgba(24,128,201,0.4)'"
          onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 20px rgba(24,128,201,0.3)'"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Solicitar interconsulta
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <p class="text-sm mt-4" style="color: var(--color-text-muted);">
          Respuesta en menos de 48 horas hábiles
        </p>
      </div>
    </div>

  </div>
</section>
