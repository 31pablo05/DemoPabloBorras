---
// LibroTecnico.astro — Presentación premium del libro (SOLO para sección veterinarios)
// IMPORTANTE: Este componente NO debe usarse en tutores ni en la home principal.
const beneficios = [
  'Enfermedades infecciosas y parasitarias con énfasis en América Latina y Europa',
  'Abordaje basado en evidencia científica actualizada',
  'Casos clínicos reales con diagnóstico diferencial',
  'Protocolos terapéuticos aplicables a la práctica diaria',
  'Bibliografía internacional de referencia',
];

const publicoObjetivo = [
  'Médicos veterinarios en ejercicio clínico',
  'Residentes y pasantes veterinarios',
  'Docentes universitarios de ciencias veterinarias',
  'Profesionales en formación de posgrado',
];
---

<!-- Sección del libro técnico: diseño premium mejorado -->
<section class="lb-book">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex justify-center lb-book-badge-wrap">
      <span
        class="inline-flex items-center gap-2 text-sm font-bold px-5 py-2.5 rounded-xl"
        style="background: linear-gradient(135deg, rgba(24,128,201,0.12) 0%, rgba(24,59,127,0.10) 100%); color: #1880c9; border: 2px solid rgba(24,128,201,0.25);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        Exclusivo para médicos veterinarios
      </span>
    </div>

    <!-- Card premium mejorada -->
    <div
      class="lb-book-card rounded-3xl overflow-hidden flex flex-col lg:flex-row relative"
    >

      <div class="lb-book-visual shrink-0 flex flex-col items-center justify-center relative overflow-hidden">
        <div class="lb-book-visual-pattern absolute inset-0 pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10 flex flex-col items-center lb-book-visual-stack">
          <img
            src="/imagenes/perfil/pablo1.webp"
            alt="Pablo Borrás sosteniendo su libro"
            class="rounded-2xl w-full object-cover object-top lb-book-photo"
            loading="lazy"
          />
          <img
            src="/imagenes/libro/port.webp"
            alt="Portada del Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro — Pablo Borrás"
            class="rounded-xl lb-book-cover"
            width="220"
            height="290"
            loading="lazy"
          />
        </div>
      </div>

      <div class="flex-1 lb-book-content bg-white">

        <h2
          class="text-3xl lg:text-4xl font-bold lb-book-title"
          style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
        >
          Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro
        </h2>

        <p class="text-base md:text-lg leading-relaxed lb-book-lead" style="color: var(--color-text-muted);">
          Este libro fue pensado con el objetivo de brindar herramientas, conocimientos y actualizaciones
          sobre diferentes enfermedades producidas por <strong>virus, bacterias, hongos, protozoarios y helmintos</strong>
          que afectan a los perros de todo el mundo, con mayor énfasis en América Latina y Europa. Cuenta con la colaboración de más de 50 investigadores de todo el mundo.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 items-stretch lb-book-grid">

          <div
            class="lb-info-card p-5 md:p-6 rounded-2xl relative overflow-hidden h-full"
            style="background: white; box-shadow: 0 3px 16px rgba(0,0,0,0.06); border-top: 4px solid #1880c9;"
          >
            <div
              style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%); pointer-events: none;"
              aria-hidden="true"
            ></div>
            <div style="position: relative; z-index: 1;">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(24,128,201,0.12); border: 2px solid rgba(24,128,201,0.2);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <h4
                  class="font-bold text-base uppercase tracking-wider"
                  style="color: #1880c9; font-family: var(--font-body);"
                >
                  Dirigido a:
                </h4>
              </div>
              <ul class="space-y-2.5">
                {publicoObjetivo.map(pub => (
                  <li class="flex items-start gap-2.5 text-sm" style="color: var(--color-text-muted);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                    {pub}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div
            class="lb-info-card p-5 md:p-6 rounded-2xl relative overflow-hidden h-full"
            style="background: white; box-shadow: 0 3px 16px rgba(0,0,0,0.06); border-top: 4px solid #183b7f;"
          >
            <div
              style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(24,59,127,0.05) 0%, transparent 100%); pointer-events: none;"
              aria-hidden="true"
            ></div>
            <div style="position: relative; z-index: 1;">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(24,59,127,0.12); border: 2px solid rgba(24,59,127,0.2);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#183b7f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                  </svg>
                </div>
                <h4
                  class="font-bold text-base uppercase tracking-wider"
                  style="color: #183b7f; font-family: var(--font-body);"
                >
                  Qué vas a encontrar:
                </h4>
              </div>
              <ul class="space-y-2.5">
                {beneficios.map(b => (
                  <li class="flex items-start gap-2.5 text-sm" style="color: var(--color-text-muted);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#183b7f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>

        <div class="flex items-center gap-6 lb-price-block rounded-2xl">
          <div class="flex-1 min-w-0">
            <p class="text-4xl font-bold" style="font-family: var(--font-display); color: #1880c9;">104 €</p>
            <p class="text-sm mt-1.5" style="color: var(--color-text-muted);">Impuestos incluidos · Envío internacional disponible</p>
            <p class="text-xs mt-2 font-semibold" style="color: var(--color-text);">Editorial: Multimedica Ediciones Veterinarias</p>
          </div>
          <img
            src="/imagenes/libro/libroport.webp"
            alt="Silueta del libro"
            aria-hidden="true"
            class="lb-price-cover"
            loading="lazy"
          />
        </div>

        <div class="lb-buy">
          <a
            href="https://libros-veterinaria.multimedica.es/parasitologia/472-manual-practico-de-enfermedades-infecciosas-y-parasitarias-del-perro.html"
            target="_blank"
            rel="noopener noreferrer"
            class="lb-buy-primary inline-flex items-center justify-center gap-3 text-base font-bold rounded-xl"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            Obtener el libro
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>

          <div class="lb-buy-alt">
            <a
              href="https://www.mercadolibre.com.ar/borras-manual-enfermedades-infecciosas-y-parasitarias-perro/up/MLAU426974103#polycard_client=search-desktop&be_origin=backend&search_layout=grid&position=7&type=product&float_highlight=last_units&tracking_id=c5fc6b0f-02dc-4397-b432-ee73603769fb&wid=MLA1439922199&sid=search"
              target="_blank"
              rel="noopener noreferrer"
              class="lb-buy-ml inline-flex items-center justify-center gap-2 font-bold rounded-xl"
            >
              Mercado Libre
            </a>

            <a
              href="https://www.amazon.com/s?k=manual+practico+enfermedades+infecciosas+parasitarias+perro+borras"
              target="_blank"
              rel="noopener noreferrer"
              class="lb-buy-amazon inline-flex items-center justify-center gap-2 font-bold rounded-xl"
            >
              Amazon
            </a>
          </div>
        </div>

        <div
          class="lb-press p-5 md:p-6 rounded-2xl relative overflow-hidden"
          style="background: linear-gradient(135deg, rgba(24,128,201,0.08) 0%, rgba(24,59,127,0.06) 100%); border-left: 4px solid #1880c9;"
        >
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(24,128,201,0.15); border: 2px solid rgba(24,128,201,0.25);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: #1880c9;">Destacado en prensa especializada</p>
              <p class="text-sm md:text-base leading-relaxed mb-3" style="color: var(--color-text-muted);">
                El libro fue destacado por la revista <strong style="color: var(--color-text);">Motivar — Sanidad Animal</strong> como referencia clínica para el ejercicio veterinario cotidiano.
              </p>
              <a
                href="https://www.motivar.com.ar/sanidad-animal/manual-practico-enfermedades-infecciosas-y-parasitarias-el-perro-n5333670"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold hover:gap-3 transition-all"
                style="color: #1880c9; text-decoration: none;"
              >
                Leer nota en Motivar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .lb-book {
    background: #fff;
    padding: 2.5rem 0 2.75rem;
  }

  .lb-book-badge-wrap {
    margin-bottom: 1.35rem;
  }

  .lb-book-card {
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
  }

  .lb-book-visual {
    background: linear-gradient(135deg, #1880c9 0%, #0d5a99 100%);
    padding: 1.1rem 1.1rem 1.35rem;
  }

  .lb-book-visual::after {
    content: none;
  }

  .lb-book-visual-pattern {
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
    background-size: 30px 30px;
    opacity: 0.4;
  }

  .lb-book-visual-stack {
    width: 100%;
    max-width: 16.5rem;
    position: relative;
  }

  .lb-book-photo {
    max-height: 200px;
    object-position: center 16%;
    box-shadow: 0 8px 28px rgba(0,0,0,0.35);
    border: 3px solid rgba(255,255,255,0.15);
  }

  .lb-book-cover {
    width: 11.25rem;
    height: auto;
    margin-top: -2.5rem;
    position: relative;
    z-index: 2;
    box-shadow: 0 12px 36px rgba(0,0,0,0.38);
    border: 2px solid rgba(255,255,255,0.12);
  }

  .lb-book-content {
    padding: 1.4rem 1.2rem 1.6rem;
    min-width: 0;
  }

  .lb-book-title {
    margin-bottom: 0.8rem;
  }

  .lb-book-lead {
    margin-bottom: 1.2rem;
  }

  .lb-book-grid {
    margin-bottom: 1.2rem;
  }

  .lb-price-block {
    background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
    border-left: 4px solid #1880c9;
    padding: 0.95rem 1.1rem;
    margin-bottom: 1.1rem;
  }

  .lb-price-cover {
    height: 84px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(4,13,78,0.2));
  }

  .lb-buy {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 1.2rem;
  }

  .lb-buy-primary {
    width: 100%;
    padding: 0.9rem 1.35rem;
    background: linear-gradient(135deg, #1880c9 0%, #0d9488 100%);
    color: white;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(24,128,201,0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .lb-buy-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(24,128,201,0.35);
  }

  .lb-buy-alt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .lb-buy-ml,
  .lb-buy-amazon {
    padding: 0.72rem 0.45rem;
    font-size: 0.8rem;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .lb-buy-ml {
    border: 2px solid #1880c9;
    color: #1880c9;
    background: transparent;
  }

  .lb-buy-amazon {
    border: 2px solid #183b7f;
    color: #183b7f;
    background: transparent;
  }

  .lb-buy-ml:hover {
    background: rgba(24,128,201,0.08);
  }

  .lb-buy-amazon:hover {
    background: rgba(24,59,127,0.08);
  }

  @media (max-width: 359px) {
    .lb-buy-alt {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) {
    .lb-book {
      padding: 3rem 0 3.25rem;
    }

    .lb-book-badge-wrap {
      margin-bottom: 1.75rem;
    }

    .lb-book-content {
      padding: 1.85rem 2rem 2rem;
    }

    .lb-book-title {
      margin-bottom: 1rem;
    }

    .lb-book-lead {
      margin-bottom: 1.5rem;
    }

    .lb-book-grid {
      margin-bottom: 1.5rem;
    }

    .lb-price-block {
      padding: 1.15rem 1.35rem;
      margin-bottom: 1.35rem;
    }

    .lb-price-cover {
      height: 104px;
    }

    .lb-buy {
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .lb-book {
      padding: 3.25rem 0 3.5rem;
    }

    .lb-book-visual {
      width: 19rem;
      padding: 0 0 1.4rem;
      align-self: stretch;
    }

    .lb-book-visual::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 46%;
      background: linear-gradient(to top, rgba(13,90,153,0.78) 0%, rgba(13,90,153,0.28) 55%, transparent 100%);
      pointer-events: none;
      z-index: 1;
    }

    .lb-book-visual-stack {
      max-width: none;
      height: 100%;
      min-height: 28rem;
      justify-content: flex-end;
    }

    .lb-book-photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-height: none;
      border-radius: 0;
      border: 0;
      object-fit: cover;
      object-position: center 14%;
    }

    .lb-book-cover {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 48%;
      width: 14.25rem;
      margin-top: 0;
    }

    .lb-book-content {
      padding: 2rem 2.15rem 2.15rem;
    }

    .lb-buy {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: stretch;
    }

    .lb-buy-primary {
      width: auto;
      flex: 1 1 16rem;
    }

    .lb-buy-alt {
      flex: 1 1 15rem;
    }

    .lb-buy-ml,
    .lb-buy-amazon {
      font-size: 0.875rem;
      padding: 0.85rem 0.75rem;
    }
  }
</style>
