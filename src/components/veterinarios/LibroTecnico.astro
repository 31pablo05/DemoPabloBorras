---
// LibroTecnico.astro — Presentación premium del libro (SOLO para sección veterinarios)
// IMPORTANTE: Este componente NO debe usarse en tutores ni en la home principal.
import Button from '../ui/Button.astro';

const beneficios = [
  'Enfermedades infecciosas y parasitarias con énfasis en América Latina y Europa',
  'Abordaje basado en evidencia científica actualizada',
  'Casos clínicos reales con diagnóstico diferencial',
  'Protocolos terapéuticos aplicables a la práctica diaria',
  'Bibliografía internacional de referencia',
];

const publicoObjetivo = [
  'Médicos veterinarios en ejercicio clínico',
  'Residentes y pasantes veterinarios',
  'Docentes universitarios de ciencias veterinarias',
  'Profesionales en formación de posgrado',
];
---

<!-- Sección del libro técnico: diseño premium mejorado -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Badge exclusivo mejorado -->
    <div class="flex justify-center mb-12">
      <span
        class="inline-flex items-center gap-2 text-sm font-bold px-5 py-2.5 rounded-xl"
        style="background: linear-gradient(135deg, rgba(24,128,201,0.12) 0%, rgba(74,61,158,0.12) 100%); color: #1880c9; border: 2px solid rgba(24,128,201,0.25);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        Exclusivo para médicos veterinarios
      </span>
    </div>

    <!-- Card premium mejorada -->
    <div
      class="rounded-3xl overflow-hidden flex flex-col lg:flex-row relative"
      style="box-shadow: 0 10px 40px rgba(0,0,0,0.12);"
    >

      <!-- Panel izquierdo: Imágenes con gradiente celeste -->
      <div
        class="lg:w-80 shrink-0 flex flex-col items-center justify-center gap-8 py-12 px-8 relative overflow-hidden"
        style="background: linear-gradient(135deg, #1880c9 0%, #0d5a99 100%);"
      >
        <!-- Patrón decorativo -->
        <div
          style="
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
            background-size: 30px 30px;
            opacity: 0.4;
          "
          aria-hidden="true"
        ></div>

        <div class="relative z-10 flex flex-col items-center gap-8">
          <!-- Foto de Pablo sosteniendo el libro -->
          <img
            src="/imagenes/perfil/pablo1.jpg"
            alt="Pablo Borrás sosteniendo su libro"
            class="rounded-2xl w-full object-cover object-top"
            style="
              max-height: 260px;
              object-position: center 20%;
              box-shadow: 0 8px 32px rgba(0,0,0,0.4);
              border: 3px solid rgba(255,255,255,0.15);
            "
          />
          <!-- Portada del libro -->
          <img
            src="/imagenes/libro/port.jpg"
            alt="Portada del Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro — Pablo Borrás"
            class="rounded-xl"
            style="box-shadow: 0 12px 40px rgba(0,0,0,0.35); border: 2px solid rgba(255,255,255,0.1);"
            width="220"
            height="290"
          />
        </div>
      </div>

      <!-- Contenido mejorado -->
      <div class="flex-1 p-10 lg:p-14 bg-white">

        <h2
          class="text-3xl lg:text-4xl font-bold mb-6"
          style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
        >
          Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro
        </h2>

        <p class="text-base md:text-lg leading-relaxed mb-10" style="color: var(--color-text-muted);">
          Este libro fue pensado con el objetivo de brindar herramientas, conocimientos y actualizaciones
          sobre diferentes enfermedades producidas por <strong>virus, bacterias, hongos, protozoarios y helmintos</strong>
          que afectan a los perros de todo el mundo, con mayor énfasis en América Latina y Europa.
        </p>

        <!-- Grid mejorado: Público + Beneficios -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">

          <!-- Público objetivo - Card celeste -->
          <div
            class="p-6 rounded-2xl relative overflow-hidden"
            style="background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;"
          >
            <div
              style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%); pointer-events: none;"
              aria-hidden="true"
            ></div>
            <div style="position: relative; z-index: 1;">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(24,128,201,0.12); border: 2px solid rgba(24,128,201,0.2);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <h4
                  class="font-bold text-base uppercase tracking-wider"
                  style="color: #1880c9; font-family: var(--font-body);"
                >
                  Dirigido a:
                </h4>
              </div>
              <ul class="space-y-2.5">
                {publicoObjetivo.map(pub => (
                  <li class="flex items-start gap-2.5 text-sm" style="color: var(--color-text-muted);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                    {pub}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Beneficios - Card violeta -->
          <div
            class="p-6 rounded-2xl relative overflow-hidden"
            style="background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #4a3d9e;"
          >
            <div
              style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(74,61,158,0.05) 0%, transparent 100%); pointer-events: none;"
              aria-hidden="true"
            ></div>
            <div style="position: relative; z-index: 1;">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(74,61,158,0.12); border: 2px solid rgba(74,61,158,0.2);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a3d9e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                  </svg>
                </div>
                <h4
                  class="font-bold text-base uppercase tracking-wider"
                  style="color: #4a3d9e; font-family: var(--font-body);"
                >
                  Qué vas a encontrar:
                </h4>
              </div>
              <ul class="space-y-2.5">
                {beneficios.map(b => (
                  <li class="flex items-start gap-2.5 text-sm" style="color: var(--color-text-muted);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4a3d9e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>

        <!-- Precio y editorial mejorados -->
        <div class="flex items-center gap-8 mb-8 p-6 rounded-2xl" style="background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%); border-left: 4px solid #1880c9;">
          <div class="flex-1">
            <p class="text-4xl font-bold" style="font-family: var(--font-display); color: #1880c9;">104 €</p>
            <p class="text-sm mt-1.5" style="color: var(--color-text-muted);">Impuestos incluidos · Envío internacional disponible</p>
            <p class="text-xs mt-2 font-semibold" style="color: var(--color-text);">Editorial: Multimedica Ediciones Veterinarias</p>
          </div>
          <img
            src="/imagenes/libro/libroport.png"
            alt="Silueta del libro"
            aria-hidden="true"
            style="height: 120px; width: auto; object-fit: contain; filter: drop-shadow(0 6px 20px rgba(4,13,78,0.2));"
          />
        </div>

        <!-- CTAs mejorados -->
        <div class="flex flex-wrap gap-3 mb-10">
          <!-- CTA principal con gradiente -->
          <a
            href="https://libros-veterinaria.multimedica.es/parasitologia/472-manual-practico-de-enfermedades-infecciosas-y-parasitarias-del-perro.html"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-7 py-4 text-base font-bold rounded-xl transition-all"
            style="
              background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
              color: white;
              text-decoration: none;
              box-shadow: 0 4px 20px rgba(24,128,201,0.3);
            "
            onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 32px rgba(24,128,201,0.4)'"
            onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 20px rgba(24,128,201,0.3)'"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            Obtener el libro
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>

          <!-- Mercado Libre -->
          <a
            href="https://www.mercadolibre.com.ar/borras-manual-enfermedades-infecciosas-y-parasitarias-perro/up/MLAU426974103#polycard_client=search-desktop&be_origin=backend&search_layout=grid&position=7&type=product&float_highlight=last_units&tracking_id=c5fc6b0f-02dc-4397-b432-ee73603769fb&wid=MLA1439922199&sid=search"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 font-bold transition-all duration-200 px-6 py-4 text-sm rounded-xl"
            style="border: 2px solid #1880c9; color: #1880c9; text-decoration: none; background: transparent;"
            onmouseover="this.style.background='rgba(24,128,201,0.08)'; this.style.transform='scale(1.02)'"
            onmouseout="this.style.background='transparent'; this.style.transform='scale(1)'"
          >
            Mercado Libre
          </a>

          <!-- Amazon -->
          <a
            href="https://www.amazon.com/s?k=manual+practico+enfermedades+infecciosas+parasitarias+perro+borras"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 font-bold transition-all duration-200 px-6 py-4 text-sm rounded-xl"
            style="border: 2px solid #F97316; color: #F97316; text-decoration: none; background: transparent;"
            onmouseover="this.style.background='rgba(249,115,22,0.08)'; this.style.transform='scale(1.02)'"
            onmouseout="this.style.background='transparent'; this.style.transform='scale(1)'"
          >
            Amazon
          </a>

          <!-- Consulta por muestra -->
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 font-bold transition-all duration-200 px-6 py-4 text-sm rounded-xl"
            style="border: 2px solid #D1D5DB; color: var(--color-text-muted); text-decoration: none; background: transparent;"
            onmouseover="this.style.borderColor='#4a3d9e'; this.style.color='#4a3d9e'; this.style.transform='scale(1.02)'"
            onmouseout="this.style.borderColor='#D1D5DB'; this.style.color='var(--color-text-muted)'; this.style.transform='scale(1)'"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Consultá por un capítulo de muestra
          </a>
        </div>

        <!-- Destacado de prensa mejorado -->
        <div 
          class="p-7 rounded-2xl relative overflow-hidden" 
          style="background: linear-gradient(135deg, rgba(24,128,201,0.08) 0%, rgba(74,61,158,0.08) 100%); border-left: 4px solid #1880c9;"
        >
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(24,128,201,0.15); border: 2px solid rgba(24,128,201,0.25);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: #1880c9;">Destacado en prensa especializada</p>
              <p class="text-sm md:text-base leading-relaxed mb-3" style="color: var(--color-text-muted);">
                El libro fue destacado por la revista <strong style="color: var(--color-text);">Motivar — Sanidad Animal</strong> como referencia clínica para el ejercicio veterinario cotidiano.
              </p>
              <a
                href="https://www.motivar.com.ar/sanidad-animal/manual-practico-enfermedades-infecciosas-y-parasitarias-el-perro-n5333670"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold hover:gap-3 transition-all"
                style="color: #1880c9; text-decoration: none;"
              >
                Leer nota en Motivar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
