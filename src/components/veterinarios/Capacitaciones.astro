---
// Capacitaciones.astro — Cards de capacitaciones para veterinarios
import { capacitaciones } from '../../data/capacitaciones.js';
import SectionTitle from '../ui/SectionTitle.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

type BadgeColor = 'blue' | 'green' | 'purple' | 'orange' | 'gray';

const modalidadColor: Record<string, BadgeColor> = {
  Presencial: 'blue',
  Online:     'green',
  Híbrido:    'purple',
};

const nivelColor: Record<string, BadgeColor> = {
  'Avanzado':          'orange',
  'Intermedio':        'blue',
  'Básico-Intermedio': 'green',
};
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Título de sección -->
    <div class="text-center mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
        Formación continua
      </p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
        Programas de capacitación
      </h2>
      <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
      <p class="text-base leading-relaxed mt-6 max-w-3xl mx-auto" style="color: var(--color-text-muted);">
        Diseñados para veterinarios en ejercicio que buscan actualización clínica, nuevas herramientas diagnósticas y protocolos terapéuticos basados en evidencia. Modalidades presencial, online e híbrida según la propuesta.
      </p>
    </div>

    <!-- Cards de capacitaciones mejoradas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {capacitaciones.map((cap, index) => {
        // Alternar colores entre celeste y violeta
        const cardColor = index % 2 === 0 ? '#1880c9' : '#4a3d9e';
        const gradientBg = index % 2 === 0 
          ? 'linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%)'
          : 'linear-gradient(135deg, rgba(74,61,158,0.05) 0%, transparent 100%)';
        
        return (
          <div
            class="bg-white rounded-2xl p-7 flex flex-col relative overflow-hidden transition-all duration-300"
            style={`box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid ${cardColor};`}
            onmouseover={`this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'`}
            onmouseout={`this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)'`}
          >
            <!-- Gradiente de fondo -->
            <div
              style={`position: absolute; inset: 0; background: ${gradientBg}; pointer-events: none;`}
              aria-hidden="true"
            ></div>

            <div style="position: relative; z-index: 1;">
              <!-- Ícono decorativo -->
              <div 
                class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" 
                style={`background: ${index % 2 === 0 ? 'rgba(24,128,201,0.12)' : 'rgba(74,61,158,0.12)'}; border: 2px solid ${index % 2 === 0 ? 'rgba(24,128,201,0.2)' : 'rgba(74,61,158,0.2)'};`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={cardColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              </div>

              <!-- Header badges -->
              <div class="flex flex-wrap gap-2 mb-4">
                <Badge label={cap.modalidad} color={modalidadColor[cap.modalidad] || 'gray'} />
                <Badge label={cap.nivel} color={nivelColor[cap.nivel] || 'gray'} />
              </div>

              <!-- Título -->
              <h3
                class="text-lg font-bold mb-2"
                style="font-family: var(--font-display); color: var(--color-text); line-height: 1.3;"
              >
                {cap.titulo}
              </h3>

              <!-- Duración con icono -->
              <div class="flex items-center gap-2 mb-4">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={cardColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <p class="text-xs font-semibold" style={`color: ${cardColor};`}>
                  {cap.duracion}
                </p>
              </div>

              <!-- Descripción -->
              <p class="text-sm leading-relaxed mb-5 flex-1" style="color: var(--color-text-muted);">
                {cap.descripcion}
              </p>

              <!-- Temas como pills mejorados -->
              <div class="flex flex-wrap gap-2 mb-6">
                {cap.temas.map(tema => (
                  <span
                    class="text-xs font-medium px-3 py-1.5 rounded-lg transition-all hover:scale-105"
                    style={`background: ${index % 2 === 0 ? 'rgba(24,128,201,0.1)' : 'rgba(74,61,158,0.1)'}; color: ${cardColor}; border: 1.5px solid ${index % 2 === 0 ? 'rgba(24,128,201,0.25)' : 'rgba(74,61,158,0.25)'};`}
                  >
                    {tema}
                  </span>
                ))}
              </div>

              <!-- CTA mejorado -->
              <a
                href="/contacto?tab=capacitaciones"
                class="inline-flex items-center justify-center gap-2 w-full py-3 text-sm font-bold rounded-xl transition-all duration-200"
                style={`background: ${cardColor}; color: #fff; text-decoration: none;`}
                onmouseover={`this.style.transform='scale(1.02)'; this.style.boxShadow='0 4px 16px rgba(0,0,0,0.2)'`}
                onmouseout={`this.style.transform='scale(1)'; this.style.boxShadow='none'`}
              >
                Consultar disponibilidad
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Próximas capacitaciones -->
    <div class="mt-16">
      <div class="text-center mb-8">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Agenda
        </p>
        <h3 class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-display); color: var(--color-text);">
          Próximas capacitaciones
        </h3>
      </div>

      <div class="max-w-3xl mx-auto">
        <div
          class="bg-white rounded-2xl p-7 flex flex-col md:flex-row md:items-center md:justify-between gap-5 relative overflow-hidden"
          style="box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;"
        >
          <div
            style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%); pointer-events: none;"
            aria-hidden="true"
          ></div>

          <div style="position: relative; z-index: 1;">
            <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: #1880c9;">
              SinapsisVet
            </p>
            <p class="text-lg font-bold" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.3;">
              Capacitación online - Próxima edición
            </p>
          </div>

          <a
            href="https://sinapsisvet.com/course/45/detail"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold rounded-xl transition-all duration-200 shrink-0"
            style="background: #1880c9; color: #fff; text-decoration: none; position: relative; z-index: 1;"
            onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 4px 16px rgba(0,0,0,0.2)'"
            onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none'"
          >
            Ver curso en SinapsisVet →
          </a>
        </div>
      </div>
    </div>

    <!-- CTA a medida mejorado -->
    <div class="mt-16 text-center">
      <div class="inline-block">
        <button
          type="button"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
          style="
            background: linear-gradient(135deg, #4a3d9e 0%, #1880c9 100%);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(74,61,158,0.3);
          "
          onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 32px rgba(74,61,158,0.4)'"
          onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 20px rgba(74,61,158,0.3)'"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Próximamente — Dejá tus datos
        </button>
        <p class="text-sm mt-4" style="color: var(--color-text-muted);">
          Estamos preparando nuevas capacitaciones. Dejá tu email y te avisamos cuando estén disponibles.
        </p>
        <form class="mt-4 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-center">
          <input
            type="email"
            placeholder="Tu email profesional"
            class="px-4 py-3 rounded-xl text-sm"
            style="border: 1.5px solid #cbd5e1; min-width: 260px; color: var(--color-text); background: #ffffff;"
            required
          />
          <button
            type="submit"
            class="px-5 py-3 text-sm font-bold rounded-xl transition-all duration-200"
            style="background: #1880c9; color: #fff;"
            onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 4px 16px rgba(24,128,201,0.3)'"
            onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none'"
          >
            Enviar
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
