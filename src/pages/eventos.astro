---
// pages/eventos.astro — Agenda completa de eventos
import Layout from '../layouts/Layout.astro';
import AgendaEventos from '../components/eventos/AgendaEventos.astro';
---

<Layout
  title="Congresos y eventos veterinarios — Pablo Borrás Speaker Internacional"
  description="Agenda de participación de Pablo Borrás en congresos veterinarios nacionales e internacionales. ECVIM, WAAVP, AVEACA y más. Solicitar invitación como ponente."
>
  <!-- Preload imágenes hero responsive -->
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraeven1.png" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraeven1mob.png" media="(max-width: 767px)" fetchpriority="high" />

  <!-- Hero mejorado -->
  <section
    class="page-hero relative overflow-hidden"
    style="
      display: flex;
      align-items: center;
    "
  >
    <!-- Imagen de fondo responsive -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="z-index: 0;"
      aria-hidden="true"
    >
      <!-- Desktop -->
      <img
        src="/imagenes/heros/paraeven1.png"
        alt=""
        class="hidden md:block w-full h-full object-cover"
        style="object-position: center 65%;"
      />
      <!-- Mobile -->
      <img
        src="/imagenes/heros/paraeven1mob.png"
        alt=""
        class="block md:hidden w-full h-full object-cover"
        style="object-position: center 65%;"
      />
    </div>

    <!-- Patrón decorativo -->
    <div
      style="
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
        background-size: 40px 40px;
        opacity: 0.3;
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Blob decorativo superior derecho -->
    <div
      style="
        position: absolute;
        top: -10%;
        right: -5%;
        width: 550px;
        height: 550px;
        background: radial-gradient(circle, rgba(74,61,158,0.4) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(70px);
        z-index: 2;
      "
      aria-hidden="true"
    ></div>

    <!-- Blob decorativo inferior izquierdo -->
    <div
      style="
        position: absolute;
        bottom: -15%;
        left: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(24,128,201,0.35) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(60px);
        z-index: 2;
      "
      aria-hidden="true"
    ></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 text-center" style="position: relative; z-index: 10;">
      <!-- Badge superior mejorado -->
      <div class="inline-block mb-6">
        <span
          class="inline-flex items-center gap-2 text-xs font-bold uppercase px-5 py-2.5 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25);"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Speaker Internacional
        </span>
      </div>

      <!-- Título con gradiente -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6"
        style="
          font-family: var(--font-display);
          background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          line-height: 1.2;
        "
      >
        Agenda de eventos
      </h1>

      <p class="text-lg md:text-xl text-white/85 max-w-3xl mx-auto mb-12 leading-relaxed">
        Congresos, jornadas, workshops y simposios donde Pablo Borrás participa como speaker, trainer o panelista a nivel nacional e internacional.
      </p>

      <!-- Stats pills -->
      <div class="flex flex-wrap justify-center gap-4 mb-10">
        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Participación</p>
            <p class="text-sm font-bold text-white">Congresos internacionales</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Formatos</p>
            <p class="text-sm font-bold text-white">Keynotes y workshops</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Temáticas</p>
            <p class="text-sm font-bold text-white">Infectología y parasitología</p>
          </div>
        </div>
      </div>

      <!-- CTA principal del hero -->
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#agenda"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
          style="
            background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 24px rgba(24,128,201,0.4);
          "
          onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 36px rgba(24,128,201,0.5)'"
          onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 24px rgba(24,128,201,0.4)'"
        >
          Ver próximos eventos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

        <a
          href="/contacto?tab=eventos"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl backdrop-blur-md transition-all"
          style="
            background: rgba(255,255,255,0.15);
            color: white;
            text-decoration: none;
            border: 2px solid rgba(255,255,255,0.3);
          "
          onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='scale(1.02)'"
          onmouseout="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='scale(1)'"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Invitar a tu evento
        </a>
      </div>
    </div>
  </section>

  <!-- Agenda completa (timeline) -->
  <AgendaEventos />

</Layout>
