---
// pages/veterinarios/libro.astro — Página del libro técnico con FAQ acordeón
import Layout from '../../layouts/Layout.astro';
import LibroTecnico from '../../components/veterinarios/LibroTecnico.astro';
---

<Layout
  title="Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro — Pablo Borrás"
  description="Libro técnico veterinario sobre enfermedades infecciosas y parasitarias en el perro. Autor: Pablo Borrás. Publicado por Multimedica Ediciones Veterinarias. Disponible online."
>

  <!-- Hero mejorado -->
  <section
    class="relative overflow-hidden"
    style="
      min-height: 80vh;
      display: flex;
      align-items: center;
      background:
        linear-gradient(135deg, rgba(4,13,78,0.85) 0%, rgba(24,128,201,0.80) 100%),
        url('/imagenes/perfil/pablo2.jpg') center 20% / 35% auto no-repeat;
    "
  >
    <!-- Patrón decorativo -->
    <div
      style="
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
        background-size: 40px 40px;
        opacity: 0.3;
      "
      aria-hidden="true"
    ></div>

    <!-- Blob decorativo -->
    <div
      style="
        position: absolute;
        bottom: -10%;
        left: -5%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(74,61,158,0.4) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(60px);
      "
      aria-hidden="true"
    ></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20">
      <!-- Breadcrumb mejorado -->
      <nav class="text-sm mb-6 flex items-center gap-2" aria-label="Breadcrumb">
        <a
          href="/veterinarios"
          class="text-white/90 hover:text-white transition-colors flex items-center gap-1.5"
          style="text-decoration: none;"
        >
          Para veterinarios
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
        <span class="text-white/60">Libro técnico</span>
      </nav>

      <!-- Badge -->
      <div class="inline-block mb-5">
        <span
          class="text-xs font-bold uppercase px-4 py-2 rounded-lg backdrop-blur-sm"
          style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25);"
        >
          📚 Exclusivo para profesionales veterinarios
        </span>
      </div>

      <!-- Título con gradiente -->
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 max-w-4xl"
        style="
          font-family: var(--font-display);
          background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          line-height: 1.2;
        "
      >
        Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro
      </h1>

      <p class="text-lg text-white/80 max-w-3xl mb-10 leading-relaxed">
        Publicado por Multimedica Ediciones Veterinarias. Herramientas, conocimientos y actualizaciones sobre diferentes enfermedades producidas por virus, bacterias, hongos, protozoarios y helmintos.
      </p>

      <!-- Stats pills -->
      <div class="flex flex-wrap gap-4">
        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Enfoque</p>
            <p class="text-sm font-bold text-white">América Latina y Europa</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Contenido</p>
            <p class="text-sm font-bold text-white">Casos clínicos reales</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Base</p>
            <p class="text-sm font-bold text-white">Evidencia científica</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Componente del libro (NO aparece en tutores ni en el home) -->
  <LibroTecnico />

  <!-- FAQ con acordeón mejorado -->
  <section class="py-20" style="background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Título de sección -->
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          ¿Tenés dudas?
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold mb-4"
          style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
        >
          Preguntas frecuentes
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
      </div>

      <!-- Acordeón nativo con <details> mejorado -->
      <div class="space-y-4">
        {[
          {
            pregunta: '¿El libro es adecuado para residentes o recién egresados?',
            respuesta: 'El libro está pensado principalmente para veterinarios en ejercicio que enfrentan casos complejos a diario. Sin embargo, residentes y profesionales en formación de posgrado también encontrarán un material muy valioso para complementar su formación teórica con casos reales y protocolos aplicables.',
          },
          {
            pregunta: '¿Está disponible en formato digital (PDF o eBook)?',
            respuesta: 'Actualmente el libro se comercializa en una edición impresa de alta calidad. Estamos evaluando una edición digital accesible. Podés dejarnos tu email para recibir novedades sobre disponibilidad.',
          },
          {
            pregunta: '¿Con qué frecuencia se actualiza el contenido?',
            respuesta: 'La obra cuenta con una revisión bibliográfica actualizada al momento de publicación. Dado que la ciencia veterinaria avanza rápidamente, Pablo Borrás comparte actualizaciones de los protocolos a través de sus capacitaciones y contenidos digitales para quienes ya tienen el libro.',
          },
        ].map((faq, i) => {
          const colors = ['#1880c9', '#4a3d9e', '#1880c9'];
          const borderColor = colors[i % colors.length];
          
          return (
            <details
              class="group rounded-2xl overflow-hidden bg-white transition-all"
              style={`box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid ${borderColor};`}
            >
              <summary
                class="flex items-center justify-between px-6 py-5 cursor-pointer font-bold text-sm md:text-base select-none transition-colors"
                style="color: var(--color-text); list-style: none;"
              >
                <span class="flex-1 pr-4">{faq.pregunta}</span>
                <!-- Ícono +/- mejorado -->
                <div 
                  class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-transform duration-300"
                  style={`background: ${borderColor === '#1880c9' ? 'rgba(24,128,201,0.12)' : 'rgba(74,61,158,0.12)'}; color: ${borderColor};`}
                  aria-hidden="true"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-open:rotate-45 transition-transform duration-300">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </div>
              </summary>
              <div
                class="px-6 py-5 text-sm md:text-base leading-relaxed"
                style="background: linear-gradient(135deg, rgba(248,250,252,0.5) 0%, white 100%); color: var(--color-text-muted); border-top: 1px solid rgba(0,0,0,0.06);"
              >
                {faq.respuesta}
              </div>
            </details>
          );
        })}
      </div>

    </div>
  </section>

</Layout>
