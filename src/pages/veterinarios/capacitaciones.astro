---
// pages/veterinarios/capacitaciones.astro — Página de capacitaciones con formulario
import Layout from '../../layouts/Layout.astro';
import Capacitaciones from '../../components/veterinarios/Capacitaciones.astro';
import FormularioContacto from '../../components/contacto/FormularioContacto.jsx';
---

<Layout
  title="Capacitaciones veterinarias — Enfermedades Vectoriales e Infectología | Pablo Borrás"
  description="Capacitaciones presenciales y online para veterinarios en enfermedades vectoriales, infectología canina y felina, parasitología y zoonosis. Charlas, workshops y jornadas."
>

  <!-- Hero mejorado -->
  <section
    class="relative overflow-hidden"
    style="
      min-height: 80vh;
      display: flex;
      align-items: center;
      background: linear-gradient(135deg, #040d4e 0%, #1880c9 100%);
    "
  >
    <!-- Patrón decorativo -->
    <div
      style="
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
        background-size: 40px 40px;
        opacity: 0.3;
      "
      aria-hidden="true"
    ></div>

    <!-- Blob decorativo -->
    <div
      style="
        position: absolute;
        top: -10%;
        right: -5%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(74,61,158,0.4) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(60px);
      "
      aria-hidden="true"
    ></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20">
      <!-- Breadcrumb mejorado -->
      <nav class="text-sm mb-6 flex items-center gap-2" aria-label="Breadcrumb">
        <a
          href="/veterinarios"
          class="text-white/90 hover:text-white transition-colors flex items-center gap-1.5"
          style="text-decoration: none;"
        >
          Para veterinarios
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
        <span class="text-white/60">Capacitaciones</span>
      </nav>

      <!-- Badge -->
      <div class="inline-block mb-5">
        <span
          class="text-xs font-bold uppercase px-4 py-2 rounded-lg backdrop-blur-sm"
          style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25);"
        >
          🎓 Formación continua
        </span>
      </div>

      <!-- Título con gradiente -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6"
        style="
          font-family: var(--font-display);
          background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          line-height: 1.2;
        "
      >
        Capacitaciones veterinarias
      </h1>

      <p class="text-lg md:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
        Programas de formación continua basados en evidencia para profesionales en ejercicio. Modalidades presencial, online e híbrida.
      </p>

      <!-- Stats pills -->
      <div class="flex flex-wrap gap-4">
        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Modalidades</p>
            <p class="text-sm font-bold text-white">Presencial, Online, Híbrido</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Enfoque</p>
            <p class="text-sm font-bold text-white">Basado en evidencia</p>
          </div>
        </div>

        <div
          class="flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
          style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div>
            <p class="text-xs text-white/70 uppercase tracking-wider">Actualización</p>
            <p class="text-sm font-bold text-white">Continua y práctica</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cards de capacitaciones -->
  <Capacitaciones />

  <!-- Formulario pre-abierto en tab Capacitaciones -->
  <section class="py-20" style="background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Próximo paso
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold mb-4"
          style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
        >
          Consultá disponibilidad
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
        <p class="mt-4 text-base" style="color: var(--color-text-muted);">
          Completá el formulario y coordinamos los detalles de la capacitación.
        </p>
      </div>
      <div class="bg-white p-8 md:p-10 rounded-2xl" style="box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;">
        <FormularioContacto client:load />
      </div>
    </div>
  </section>

</Layout>

<script>
  if (typeof window !== 'undefined' && !new URLSearchParams(window.location.search).get('tab')) {
    const url = new URL(window.location.href);
    url.searchParams.set('tab', 'capacitaciones');
    window.history.replaceState({}, '', url.toString());
  }
</script>
