---
// pages/veterinarios/interconsultas.astro — Página de interconsultas con formulario
import Layout from '../../layouts/Layout.astro';
import Interconsultas from '../../components/veterinarios/Interconsultas.astro';
import FormularioContacto from '../../components/contacto/FormularioContacto.jsx';
---

<Layout
  title="Interconsultas clínicas veterinarias — Infectología y Parasitología | Pablo Borrás"
  description="Segunda opinión especializada en enfermedades infecciosas y parasitarias en perros y gatos. Interconsultas para veterinarios con Pablo Borrás, MSc en zoonosis."
>

  <!-- Hero mejorado -->
  <section
    class="py-24 md:py-28 relative overflow-hidden"
    style="min-height: 80vh; display: flex; align-items: center; background: linear-gradient(135deg, rgba(4,13,78,0.88) 0%, rgba(24,59,127,0.82) 50%, rgba(24,128,201,0.78) 100%), url('/imagenes/heros/mendoza.jpg') center 40% / cover no-repeat;"
  >
    <!-- Patrón de puntos decorativo -->
    <div
      style="
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
      "
      aria-hidden="true"
    ></div>
    
    <!-- Blob decorativo -->
    <div
      style="
        position: absolute;
        bottom: -100px;
        left: -100px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(24,128,201,0.15) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
      "
      aria-hidden="true"
    ></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb mejorado -->
      <nav class="flex items-center gap-2 text-sm mb-6" aria-label="Breadcrumb">
        <a href="/veterinarios" class="inline-flex items-center gap-1 transition-all hover:gap-2" style="color: #a8d8f0; text-decoration: none; font-weight: 600;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Para veterinarios
        </a>
        <span class="text-white/40">/</span>
        <span class="text-white/90 font-semibold">Interconsultas</span>
      </nav>

      <!-- Badge de servicio -->
      <div class="mb-6">
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full" style="background: rgba(255,255,255,0.12); color: #a8d8f0; border: 1px solid rgba(255,255,255,0.25); backdrop-filter: blur(10px);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
          Servicio profesional
        </span>
      </div>

      <!-- Título principal -->
      <h1
        class="text-4xl md:text-5xl font-bold text-white mb-5"
        style="font-family: var(--font-display); line-height: 1.2; text-shadow: 0 2px 20px rgba(0,0,0,0.3);"
      >
        Interconsultas clínicas<br/>
        <span style="background: linear-gradient(135deg, #ffffff 0%, #5ba8e0 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">especializadas</span>
      </h1>
      
      <p class="text-white/85 text-lg md:text-xl max-w-2xl leading-relaxed mb-8" style="text-shadow: 0 1px 8px rgba(0,0,0,0.2);">
        Segunda opinión especializada para casos complejos en enfermedades infecciosas y parasitarias. Enfoque basado en evidencia con seguimiento completo.
      </p>

      <!-- Stats rápidos -->
      <div class="flex flex-wrap gap-4 items-center">
        <div class="flex items-center gap-2 px-4 py-2 rounded-lg" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5ba8e0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="text-white/90 text-sm font-semibold">+15 años de experiencia</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 rounded-lg" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5ba8e0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
          </svg>
          <span class="text-white/90 text-sm font-semibold">Enfoque evidence-based</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 rounded-lg" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5ba8e0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="text-white/90 text-sm font-semibold">Seguimiento incluido</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido del servicio -->
  <Interconsultas />

  <!-- Formulario de contacto mejorado -->
  <section id="formulario-contacto" class="py-20" style="background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Contacto directo
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold mb-4"
          style="font-family: var(--font-display); color: var(--color-text);"
        >
          Enviá tu consulta
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full mb-4" style="background: linear-gradient(90deg, #1880c9 0%, #0d9488 100%);"></div>
        <p class="text-base" style="color: var(--color-text-muted);">
          Completá el formulario con los detalles del caso y te respondemos a la brevedad.
        </p>
      </div>
      <!-- React Island: se hidrata en el cliente con tab=interconsultas preseleccionado -->
      <div class="bg-white p-8 md:p-10 rounded-2xl" style="box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;">
        <FormularioContacto client:load />
      </div>
    </div>
  </section>

</Layout>

<!-- Script para fijar el parámetro de URL si no está presente -->
<script>
  if (typeof window !== 'undefined' && !new URLSearchParams(window.location.search).get('tab')) {
    const url = new URL(window.location.href);
    url.searchParams.set('tab', 'interconsultas');
    window.history.replaceState({}, '', url.toString());
  }
</script>
