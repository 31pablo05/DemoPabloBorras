---
// pages/veterinarios/index.astro — Hub para veterinarios con 3 subsecciones y datos de autoridad
import Layout from '../../layouts/Layout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';
import PodcastsMNV from '../../components/veterinarios/PodcastsMNV.astro';

const subsecciones = [
  {
    href: '/veterinarios/interconsultas',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
    </svg>`,
    titulo: 'Veterinarios derivantes',
    descripcion: 'Pablo Borrás junto al veterinario consultante analiza el caso, el historial clínico del paciente y propone un enfoque diagnóstico y terapéutico detallado basado en evidencia científica actualizada.',
    cta: 'Ver interconsultas',
  },
  {
    href: '/veterinarios/capacitaciones',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>`,
    titulo: 'Capacitaciones',
    descripcion: 'Enfermedades vectoriales, infectología canina y felina, zoonosis y parasitología. Presenciales, online e híbridas. Charlas, workshops, jornadas y congresos.',
    cta: 'Ver capacitaciones',
  },
  {
    href: '/veterinarios/libro',
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
    </svg>`,
    titulo: 'Libro técnico',
    descripcion: 'Manual Práctico de Enfermedades Infecciosas y Parasitarias en el Perro. Publicado por Multimedica Ediciones Veterinarias. Herramienta de referencia clínica basada en evidencia científica.',
    cta: 'Ver el libro',
  },
];

const stats = [
  { numero: '+15',  label: 'Años de experiencia clínica' },
  { numero: '+30K', label: 'Seguidores en Instagram' },
  { numero: '+8',   label: 'Países donde disertó' },
  { numero: '+4',  label: 'Artículos científicos publicados' },
];
---

<Layout
  title="Para veterinarios — Interconsultas, Capacitaciones y Libro | Pablo Borrás"
  description="Interconsultas clínicas especializadas en infectología, capacitaciones en enfermedades vectoriales y libro técnico para médicos veterinarios. Por Pablo Borrás MSc."
  heroImage="/imagenes/heros/mendoza.jpg"
>

  <!-- Hero secundario mejorado -->
  <section
    class="py-24 md:py-28 relative overflow-hidden"
    style="min-height: 100svh; display: flex; align-items: center; background: url('/imagenes/heros/mendoza.jpg') center 60% / cover no-repeat;"
  >
    <!-- Patrón de puntos decorativo -->
    <div
      style="
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
      "
      aria-hidden="true"
    ></div>
    
    <!-- Blob decorativo -->
    <div
      style="
        position: absolute;
        top: -100px;
        right: -100px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(24,128,201,0.15) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
      "
      aria-hidden="true"
    ></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-5 py-2.5 rounded-full mb-7"
        style="background: rgba(255,255,255,0.12); color: #a8d8f0; border: 1px solid rgba(255,255,255,0.25); letter-spacing: 0.12em; backdrop-filter: blur(10px);"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
        </svg>
        Espacio exclusivo para profesionales
      </div>
      <h1
        class="text-4xl md:text-6xl font-bold text-white mb-6"
        style="font-family: var(--font-display); line-height: 1.15; text-shadow: 0 2px 20px rgba(0,0,0,0.3);"
      >
        Para veterinarios y<br/><span style="background: linear-gradient(135deg, #ffffff 0%, #5ba8e0 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">profesionales de la salud animal</span>
      </h1>
      <p class="text-white/85 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-8" style="text-shadow: 0 1px 8px rgba(0,0,0,0.2);">
        Herramientas diseñadas para elevar el estándar de tu ejercicio profesional: interconsultas, formación continua y material de referencia clínica.
      </p>
      <!-- Badges de credenciales -->
      <div class="flex flex-wrap justify-center gap-3 items-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); backdrop-filter: blur(10px);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
          Esp. Enf. Infecciosas
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); backdrop-filter: blur(10px);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
          </svg>
          MSc Zoonosis
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); backdrop-filter: blur(10px);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          Editor P&V
        </span>
      </div>
    </div>
  </section>

  <!-- 3 Cards de subsecciones mejoradas -->
  <section style="background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);" class="py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Servicios para colegas
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
          ¿Cómo puedo ayudarte?
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mt-12">
        {[
          { ...subsecciones[0], color: '#1880c9', bgGradient: 'linear-gradient(135deg, rgba(24,128,201,0.08) 0%, transparent 100%)', shadowColor: '24,128,201' },
          { ...subsecciones[1], color: '#4a3d9e', bgGradient: 'linear-gradient(135deg, rgba(74,61,158,0.08) 0%, transparent 100%)', shadowColor: '74,61,158' },
          { ...subsecciones[2], color: '#1880c9', bgGradient: 'linear-gradient(135deg, rgba(24,128,201,0.08) 0%, transparent 100%)', shadowColor: '24,128,201' },
        ].map((sub, index) => (
          <a
            href={sub.href}
            class="card-lift group block bg-white rounded-2xl p-8 md:p-10 no-underline relative overflow-hidden"
            style={`
              border-radius: 18px;
              box-shadow: 0 4px 24px rgba(0,0,0,0.08);
              text-decoration: none;
              border-top: 4px solid ${sub.color};
              transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
              transform-origin: center;
            `}
            onmouseover={`this.style.transform='translateY(-10px) scale(1.02)'; this.style.boxShadow='0 20px 40px rgba(${sub.shadowColor},0.25)'`}
            onmouseout={`this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.08)'`}
          >
            <!-- Gradiente de fondo -->
            <div
              style={`
                position: absolute;
                inset: 0;
                background: ${sub.bgGradient};
                pointer-events: none;
                opacity: 1;
                transition: opacity 0.3s ease;
              `}
              aria-hidden="true"
            ></div>
            
            <!-- Contenido -->
            <div style="position: relative; z-index: 1;">
              <div
                class="mb-6 w-16 h-16 flex items-center justify-center rounded-xl transition-all duration-300"
                style={`color: ${sub.color}; background: ${sub.color === '#1880c9' ? 'rgba(24,128,201,0.12)' : 'rgba(74,61,158,0.12)'}; border: 2px solid ${sub.color === '#1880c9' ? 'rgba(24,128,201,0.2)' : 'rgba(74,61,158,0.2)'};`}
                set:html={sub.icon}
              />
              <h2
                class="text-2xl font-bold mb-4"
                style="font-family: var(--font-display); color: var(--color-text); line-height: 1.3;"
              >
                {sub.titulo}
              </h2>
              <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted); line-height: 1.7;">
                {sub.descripcion}
              </p>
              <span class="text-sm font-bold group-hover:underline inline-flex items-center gap-2 transition-all" style={`color: ${sub.color};`}>
                {sub.cta}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-2">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Bloque de autoridad con stats -->
  <section class="py-20 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Texto de autoridad -->
        <div>
          <div class="mb-8">
            <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
              Autoridad clínica
            </p>
            <h2 class="text-3xl md:text-4xl font-bold mb-2" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
              Trayectoria que respalda
            </h2>
            <div class="w-16 h-1 rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
          </div>
          <p class="text-base md:text-lg leading-relaxed mb-5" style="color: var(--color-text-muted); line-height: 1.7;">
            Médico Veterinario egresado de la Universidad de Buenos Aires. Especialista
            en Enfermedades Infecciosas y Parasitarias (CPHV) y Magíster en Prevención y
            Control de Zoonosis (UNNOBA–ANLIS). Editor asociado de <em>Parasites and Vectors</em>
            (Springer Nature). Miembro del TroCCAP Council e ISCAID. Colaborador del
            servicio de Zoopatología del Hospital Francisco J. Muñiz. Actualmente
            cursando el Máster en Medicina Interna de Pequeños Animales en la
            Universidad Autónoma de Barcelona (España). Docente, investigador y speaker
            internacional con presencia en congresos en Argentina, Ecuador, Colombia,
            Uruguay, Brasil, Paraguay, España y Países Bajos.
          </p>
          <ul class="space-y-2 text-sm md:text-base mb-8" style="color: var(--color-text-muted);">
            <li class="flex items-start gap-2.5"><span style="color: var(--color-accent); font-weight: 700; font-size: 1.1em;">&#9656;</span> Editor asociado de <em>Parasites &amp; Vectors</em> — Springer Nature</li>
            <li class="flex items-start gap-2.5"><span style="color: var(--color-accent); font-weight: 700; font-size: 1.1em;">&#9656;</span> Colaborador del servicio de Zoopatología, Hospital Francisco J. Muñiz</li>
            <li class="flex items-start gap-2.5"><span style="color: var(--color-accent); font-weight: 700; font-size: 1.1em;">&#9656;</span> Actualmente cursando el Máster en Medicina Interna — Fac. Veterinaria, UAB (España)</li>
            <li class="flex items-start gap-2.5"><span style="color: var(--color-accent); font-weight: 700; font-size: 1.1em;">&#9656;</span> Miembro de TroCCAP, ISCAID y ESCCAP</li>
          </ul>

          <!-- Membresías y reconocimientos -->
          <div class="pt-6" style="border-top: 2px solid #E5EAED;">
            <p class="text-xs font-semibold uppercase tracking-wider mb-5" style="color: var(--color-text-muted); letter-spacing: 0.1em;">Membresías y reconocimientos</p>
            <div class="flex flex-wrap gap-2.5">

              <!-- TroCCAP — azul -->
              <a
                href="https://www.troccap.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold transition-all hover:scale-105 hover:shadow-lg"
                style="border-radius: 10px; background: linear-gradient(135deg, #EEF4FF 0%, #DBEAFE 100%); color: #1849A9; border: 1.5px solid #93C5FD; text-decoration: none;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                TroCCAP Council
              </a>

              <!-- ABCD — verde -->
              <a
                href="https://www.abcdcatsvets.org"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold transition-all hover:scale-105 hover:shadow-lg"
                style="border-radius: 10px; background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%); color: #166534; border: 1.5px solid #86EFAC; text-decoration: none;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                ABCD Europe
              </a>

              <!-- ISCAID — celeste -->
              <a
                href="https://www.iscaid.org"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold transition-all hover:scale-105 hover:shadow-lg"
                style="border-radius: 10px; background: linear-gradient(135deg, #F0FDFA 0%, #CCFBF1 100%); color: #065F46; border: 1.5px solid #5EEAD4; text-decoration: none;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                ISCAID Member
              </a>

              <!-- ESCCAP — verde oscuro -->
              <a
                href="https://www.esccap.org"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold transition-all hover:scale-105 hover:shadow-lg"
                style="border-radius: 10px; background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%); color: #065F46; border: 1.5px solid #6EE7B7; text-decoration: none;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                ESCCAP Member
              </a>

              <!-- Editor Parasites & Vectors — naranja -->
              <a
                href="https://link.springer.com/journal/13071"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold transition-all hover:scale-105 hover:shadow-lg"
                style="border-radius: 10px; background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%); color: #9A3412; border: 1.5px solid #FDBA74; text-decoration: none;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                Editor P&V
              </a>

              <!-- AVEACA Premio — dorado -->
              <span
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold"
                style="border-radius: 10px; background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%); color: #92400E; border: 1.5px solid #FCD34D;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                Premio AVEACA 2025
              </span>

            </div>
          </div>
        </div>

        <!-- Imagen de Pablo -->
        <div class="flex flex-col gap-6">
          <!-- Imagen con stats superpuestos abajo -->
          <div class="img-desktop-rounded overflow-hidden relative" style="box-shadow: var(--shadow-lg);">
            <img
              src="/imagenes/perfil/pablo3.jpg"
              alt="Pablo Borrás — Médico Veterinario"
              class="w-full object-cover object-top img-desktop-rounded"
            />

            <!-- Stats overlay translúcido en la parte inferior -->
            <div
              class="absolute bottom-0 left-0 right-0"
              style="
                background: linear-gradient(to top, rgba(4,13,78,0.82) 0%, rgba(4,13,78,0.55) 60%, transparent 100%);
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
                padding: 2rem 1.5rem 1.5rem;
              "
            >
              <div class="grid grid-cols-2 gap-4">
                {stats.map(stat => (
                <div class="stat-card text-center">
                  <p class="stat-number text-3xl md:text-4xl font-bold text-white" style="font-family: var(--font-display);">
                    {stat.numero}
                  </p>
                  <p class="text-xs md:text-sm text-white/80 leading-tight mt-1">
                    {stat.label}
                  </p>
                </div>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- Sección: Publicaciones científicas -->
  <section style="background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);" class="py-20 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Investigación y ciencia
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
          Publicaciones científicas
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
      </div>

      <div class="divide-y" style="border-radius: 18px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); background: #fff;">
        {[
          {
            titulo: 'Heartworm adulticide treatment: a tropical perspective',
            revista: 'Parasites &amp; Vectors — Springer Nature',
            año: '2023',
            href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10141906/',
            pdf: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10141906/pdf/13071_2023_Article_5690.pdf',
          },
          {
            titulo: 'First report of phaeohyphomycosis caused by Phialophora americana in a domestic cat from Argentina',
            revista: 'Journal of Feline Medicine and Surgery — SAGE Journals',
            año: '2022',
            href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC8908401/',
            pdf: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC8908401/pdf/10.1177_20551169221077611.pdf',
          },
          {
            titulo: 'First identification of Strongyloides stercoralis infection in a pet dog in Argentina, using integrated diagnostic approaches',
            revista: 'Parasites &amp; Vectors — Springer Nature',
            año: '2023',
            href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10605978/',
            pdf: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10605978/pdf/13071_2023_Article_6022.pdf',
          },
          {
            titulo: 'Feline tuberculosis due to Mycobacterium bovis: case series with clinical course, genotyping and therapeutic outcomes from Buenos Aires, Argentina',
            revista: 'Journal of Feline Medicine and Surgery — SAGE Journals',
            año: '2026',
            href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC13009748/',
